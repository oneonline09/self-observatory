---
import type { Note } from '../lib/content';
import { getConnectedNotes } from '../lib/content';
import { t } from '../i18n/ui';
import PostCard from './PostCard.astro';

interface Props {
  note: Note;
}
const { note } = Astro.props;
const tt = t(note.lang);
const connected = await getConnectedNotes(note);
---
<section class="connected">
  <h2>{tt('connected.title')}</h2>
  {
    connected.length ? (
      <div class="card-list">
        {connected.map((n) => <PostCard note={n} />)}
      </div>
    ) : (
      <p class="dim">{tt('connected.empty')}</p>
    )
  }
</section>
