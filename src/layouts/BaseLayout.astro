---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altUrl?: string | null;
  wide?: boolean;
}
const { lang, title, description, altUrl = null, wide = false } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead lang={lang} title={title} description={description} />
  </head>
  <body>
    <div class="sky" aria-hidden="true"></div>
    <Header lang={lang} altUrl={altUrl} />
    <main>
      <div class={wide ? 'wrap-wide' : 'wrap'}>
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>
