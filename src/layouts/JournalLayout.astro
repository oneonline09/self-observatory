---
import BaseLayout from './BaseLayout.astro';
import { t } from '../i18n/ui';
import { topicUrl, tagUrl } from '../lib/urls';
import type { JournalEntry } from '../lib/journal';
import { getJournalTranslation } from '../lib/journal';
import { getTermLabels } from '../lib/terms';
import { marked } from 'marked';

// Bối cảnh / Cơ duyên / Suy nghĩ được viết bằng Markdown (đậm, nghiêng, link, danh sách…).
// breaks: true -> một lần xuống dòng trong CMS vẫn là một lần xuống dòng trên trang.
const md = (text: string) => marked.parse(text.trim(), { breaks: true, gfm: true }) as string;
const terms = await getTermLabels();

interface Props {
  entry: JournalEntry;
}
const { entry } = Astro.props;
const { lang, data } = entry;
const tt = t(lang);
const trans = await getJournalTranslation(entry);
const altUrl = trans ? trans.url : null;

const locale = lang === 'vi' ? 'vi-VN' : 'en-US';
const dateStr = data.date.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
const weekday = data.date.toLocaleDateString(locale, { weekday: 'long' });
const pageTitle = data.title || dateStr;

const KIND_KEY = {
  event: 'jk.event',
  read: 'jk.read',
  discussion: 'jk.discussion',
  activity: 'jk.activity',
  program: 'jk.program',
  happening: 'jk.happening',
  situation: 'jk.situation',
} as const;

const hasTerms = data.topics.length > 0 || data.tags.length > 0;
---
<BaseLayout lang={lang} title={pageTitle} description={data.theme} altUrl={altUrl}>
  <article class="article">
    <p class="eyebrow" style="color:var(--journal)">Journal</p>
    <h1 class="j-date">{data.title || dateStr}</h1>
    <div class="j-weekday">{weekday}{data.title ? ` · ${dateStr}` : ''}</div>
    {data.theme && <p class="j-theme">“{data.theme}”</p>}

    {
      hasTerms && (
        <div class="chips" style="margin-top:16px">
          {data.topics.map((x) => <a class="chip topic" href={topicUrl(lang, x)}>{terms.label('topic', x, lang)}</a>)}
          {data.tags.map((x) => <a class="chip tag" href={tagUrl(lang, x)}>#{terms.label('tag', x, lang)}</a>)}
        </div>
      )
    }

    <div class="j-streamlabel">{tt('journal.inDay')} · {data.items.length} {tt('journal.count')}</div>

    {
      data.items.map((item) => (
        <div class={`jitem k-${item.kind}`}>
          <div class="jtop">
            <span class="jkind">{tt(KIND_KEY[item.kind])}</span>
            {item.name && (
              <h3>
                {item.link ? (
                  <a href={item.link} target="_blank" rel="noopener">{item.name}</a>
                ) : (
                  item.name
                )}
              </h3>
            )}
            {!item.name && item.link && (
              <a class="jlink" href={item.link} target="_blank" rel="noopener">{item.link}</a>
            )}
          </div>
          {
            (item.context || item.occasion || item.people.length > 0 || item.reflection) && (
              <div class="jfields">
                {item.context && (
                  <div class="jfield"><span class="jlabel">{tt('jf.context')}</span><div class="jval" set:html={md(item.context)} /></div>
                )}
                {item.occasion && (
                  <div class="jfield"><span class="jlabel">{tt('jf.occasion')}</span><div class="jval" set:html={md(item.occasion)} /></div>
                )}
                {item.people.length > 0 && (
                  <div class="jfield">
                    <span class="jlabel">{tt('jf.people')}</span>
                    <div class="jpeople">{item.people.map((p) => <span class="jperson">{p}</span>)}</div>
                  </div>
                )}
                {item.reflection && (
                  <div class="jfield jreflect"><span class="jlabel">{tt('jf.reflection')}</span><div class="jval" set:html={md(item.reflection)} /></div>
                )}
              </div>
            )
          }
        </div>
      ))
    }
  </article>
</BaseLayout>

<style>
  /* Giữ đúng cách xuống dòng / ngắt đoạn người viết gõ trong CMS */
  .jfields { gap: 16px; }
  .jval {
    line-height: 1.78;
    overflow-wrap: anywhere;
  }
  /* Nội dung Markdown được chèn bằng set:html nên phải dùng :global */
  .jval :global(p) { margin: 0 0 0.85em; }
  .jval :global(> :last-child) { margin-bottom: 0; }
  .jval :global(ul),
  .jval :global(ol) { margin: 0 0 0.85em; padding-left: 1.4em; }
  .jval :global(li) { margin: 0.2em 0; }
  .jval :global(blockquote) {
    margin: 0 0 0.85em;
    padding-left: 14px;
    border-left: 2px solid var(--line);
    color: var(--muted);
  }
  .jval :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .jlink { font-size: 14px; overflow-wrap: anywhere; }
  /* Bỏ thanh dọc xấu, đổi thành khối bo tròn dịu mắt */
  .jreflect {
    border-left: none;
    padding: 14px 16px;
    background: color-mix(in srgb, var(--kc, var(--journal)) 8%, var(--panel-2));
    border: 1px solid color-mix(in srgb, var(--kc, var(--journal)) 22%, transparent);
    border-radius: 12px;
  }
  .jreflect .jlabel {
    color: color-mix(in srgb, var(--kc, var(--journal)) 65%, var(--muted));
  }
  .jreflect .jval {
    color: var(--ink);
    font-size: 16px;
  }
</style>
