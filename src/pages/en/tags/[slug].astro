---
import TermPage from '../../../components/TermPage.astro';
import { getTermPaths } from '../../../lib/termPages';

export async function getStaticPaths() {
  return getTermPaths('en', 'tag');
}
const { slug } = Astro.params;
const { notes, journal, altUrl } = Astro.props;
---
<TermPage lang="en" kind="tag" term={slug} notes={notes} journal={journal} altUrl={altUrl} />
