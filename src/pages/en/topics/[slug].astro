---
import TermPage from '../../../components/TermPage.astro';
import { getTermPaths } from '../../../lib/termPages';

export async function getStaticPaths() {
  return getTermPaths('en', 'topic');
}
const { slug } = Astro.params;
const { notes, journal, altUrl } = Astro.props;
---
<TermPage lang="en" kind="topic" term={slug} notes={notes} journal={journal} altUrl={altUrl} />
