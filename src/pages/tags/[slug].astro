---
import TermPage from '../../components/TermPage.astro';
import { getTermPaths } from '../../lib/termPages';

export async function getStaticPaths() {
  return getTermPaths('vi', 'tag');
}
const { slug } = Astro.params;
const { notes, journal, altUrl } = Astro.props;
---
<TermPage lang="vi" kind="tag" term={slug} notes={notes} journal={journal} altUrl={altUrl} />
